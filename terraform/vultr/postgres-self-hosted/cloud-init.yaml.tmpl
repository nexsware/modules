#cloud-config
package_update: true
package_upgrade: true

write_files:
  - path: /opt/nexsware-pg-setup.sh
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail

      PGVER="${postgres_version}"
      PGCONF="/etc/postgresql/$PGVER/main"

      %{ if private_ip != "" ~}
      # Assign static private IP to the VPC interface
      PRIMARY_IFACE=$(ip route show default | awk '/default/ {print $5; exit}')
      VPC_IFACE=$(ip -o link show | awk -F': ' '{print $2}' | grep -v lo | grep -v "$PRIMARY_IFACE" | head -1)
      SUBNET_PREFIX=$(echo "${db_subnet}" | cut -d'/' -f2)
      cat > /etc/netplan/99-vpc-static.yaml <<NETEOF
      network:
        version: 2
        ethernets:
          $VPC_IFACE:
            dhcp4: false
            addresses:
              - ${private_ip}/$SUBNET_PREFIX
            routes:
              - to: ${bastion_subnet}
                on-link: true
              - to: ${app_subnet}
                on-link: true
      NETEOF
      chmod 600 /etc/netplan/99-vpc-static.yaml
      netplan apply
      # Remove Vultr's DHCP-assigned IP — netplan apply stops future renewals but
      # doesn't flush the existing lease, so we do it explicitly
      ip -4 addr show dev $VPC_IFACE | grep 'inet ' | awk '{print $2}' | grep -v "^${private_ip}/" | while read -r old_ip; do
        ip addr del "$old_ip" dev $VPC_IFACE 2>/dev/null || true
      done
      %{ endif ~}

      # Allow PostgreSQL connections from VPC subnets through UFW
      ufw allow from ${app_subnet} to any port ${port} proto tcp
      ufw allow from ${bastion_subnet} to any port ${port} proto tcp

      # Set listen address and port
      cat >> "$PGCONF/postgresql.conf" <<PGEOF
      listen_addresses = '${listen_address}'
      port = ${port}
      PGEOF

      # Allow connections from all private VPC ranges and localhost
      cat >> "$PGCONF/pg_hba.conf" <<PGEOF
      host    all    all    10.0.0.0/8     scram-sha-256
      host    all    all    127.0.0.1/32   scram-sha-256
      PGEOF

      systemctl restart postgresql

      # Wait for PostgreSQL to be ready
      for i in $(seq 1 30); do
        sudo -u postgres psql -c "SELECT 1" >/dev/null 2>&1 && break
        sleep 2
      done

      # Set postgres superuser password
      sudo -u postgres psql -c "ALTER USER postgres PASSWORD '${postgres_password}';"

      %{ if length(databases) > 0 ~}
      # Create databases (idempotent)
      %{ for db in databases ~}
      if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname = '${db}'" | grep -q 1; then
        sudo -u postgres psql -c "CREATE DATABASE \"${db}\""
      fi
      %{ endfor ~}
      %{ endif ~}

      %{ if length(database_users) > 0 ~}
      # Create users and grant access (idempotent)
      %{ for username, user in database_users ~}
      if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = '${username}'" | grep -q 1; then
        sudo -u postgres psql -c "CREATE USER \"${username}\" WITH PASSWORD '${user.password}'"
      fi
      %{ for db in databases ~}
      sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE \"${db}\" TO \"${username}\";"
      sudo -u postgres psql -d "${db}" -c "GRANT ALL ON SCHEMA public TO \"${username}\";"
      %{ endfor ~}
      %{ endfor ~}
      %{ endif ~}

runcmd:
  - curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/postgresql-keyring.gpg
  - echo "deb [signed-by=/usr/share/keyrings/postgresql-keyring.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" | tee /etc/apt/sources.list.d/postgresql.list
  - apt-get update
  - apt-get install -y postgresql-${postgres_version} postgresql-contrib
  - systemctl enable postgresql
  - systemctl start postgresql
  - /opt/nexsware-pg-setup.sh
  - rm -f /opt/nexsware-pg-setup.sh
