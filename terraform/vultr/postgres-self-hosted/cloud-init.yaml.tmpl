#cloud-config
package_update: true
package_upgrade: true

write_files:
  - path: /opt/nexsware-pg-setup.sh
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail

      PGVER="${postgres_version}"
      PGCONF="/etc/postgresql/$PGVER/main"

      %{ if private_ip != "" }
      # Assign static private IP to the VPC interface
      PRIMARY_IFACE=$(ip route show default | awk '/default/ {print $5; exit}')
      VPC_IFACE=$(ip -o link show | awk -F': ' '{print $2}' | grep -v lo | grep -v "$PRIMARY_IFACE" | head -1)
      SUBNET_PREFIX=$(echo "${db_subnet}" | cut -d'/' -f2)
      cat > /etc/netplan/99-vpc-static.yaml <<NETEOF
      network:
        version: 2
        ethernets:
          $VPC_IFACE:
            dhcp4: false
            addresses:
              - ${private_ip}/$SUBNET_PREFIX
            routes:
              - to: ${bastion_subnet}
                on-link: true
              - to: ${app_subnet}
                on-link: true
      NETEOF
      chmod 600 /etc/netplan/99-vpc-static.yaml
      netplan apply
      # Remove Vultr's DHCP-assigned IP — netplan apply stops future renewals but
      # doesn't flush the existing lease, so we do it explicitly
      ip -4 addr show dev $VPC_IFACE | grep 'inet ' | awk '{print $2}' | grep -v "^${private_ip}/" | while read -r old_ip; do
        ip addr del "$old_ip" dev $VPC_IFACE 2>/dev/null || true
      done
      # Apply routes immediately — netplan apply persists them but may not add them
      # to the live routing table until reboot when the interface is already up
      ip route replace ${bastion_subnet} dev $VPC_IFACE 2>/dev/null || true
      ip route replace ${app_subnet} dev $VPC_IFACE 2>/dev/null || true
      %{ endif }

      # The whole host firewall, declared here and enabled here.
      #
      # These rules used to be added without ever calling `ufw enable`, which
      # only appeared to work: Ubuntu images arrive with ufw already active and
      # a lone "allow 22 from anywhere" rule that exists in no Terraform. So the
      # policy was half image, half module, and neither half knew about the
      # other — a database server reachable on 22 from the entire internet while
      # 5432 was carefully restricted to two subnets.
      #
      # Reset first so the result is this policy, not this policy layered over
      # the image's. SSH before enable, always: enabling a default-deny firewall
      # with no SSH rule in place locks the host out, and the only way back is
      # the provider's web console.
      ufw --force reset
      ufw allow from ${bastion_subnet} to any port 22 proto tcp
      ufw allow from ${app_subnet} to any port ${port} proto tcp
      ufw allow from ${bastion_subnet} to any port ${port} proto tcp
      ufw --force enable

      %{ if harden_ssh ~}
      # Key auth only. The filename has to sort before 50-cloud-init.conf,
      # which ships PasswordAuthentication yes on Ubuntu: sshd takes the FIRST
      # value it obtains for a keyword, so a 99- file would silently lose and
      # leave passwords enabled while looking like it had disabled them.
      cat > /etc/ssh/sshd_config.d/01-nexsware-hardening.conf <<SSHEOF
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password
      SSHEOF

      # Validate before applying. A config sshd refuses to parse means it will
      # not come back up on restart, which is the same lockout by another route.
      if sshd -t 2>/dev/null; then
        systemctl reload ssh 2>/dev/null || systemctl restart ssh 2>/dev/null || true
      else
        rm -f /etc/ssh/sshd_config.d/01-nexsware-hardening.conf
      fi
      %{ endif ~}

      # Set listen address and port
      cat >> "$PGCONF/postgresql.conf" <<PGEOF
      listen_addresses = '${listen_address}'
      port = ${port}
      PGEOF

      # The same two subnets the UFW rules above admit. These were hardcoded to
      # 10.0.0.0/8, which let any address in the entire private range
      # authenticate if it could reach the port, leaving UFW as the only real
      # boundary — the two layers should agree about who may connect, so that
      # one of them being wrong is not silently survivable.
      #
      # No 127.0.0.1 line here: the distro's stock pg_hba.conf already ships
      # one, so appending a second only produced a duplicate that could never
      # match (pg_hba is first-match-wins).
      cat >> "$PGCONF/pg_hba.conf" <<PGEOF
      host    all    all    ${app_subnet}       scram-sha-256
      host    all    all    ${bastion_subnet}   scram-sha-256
      PGEOF

      systemctl restart postgresql

      # Wait for PostgreSQL to be ready
      for i in $(seq 1 30); do
        sudo -u postgres psql -c "SELECT 1" >/dev/null 2>&1 && break
        sleep 2
      done

      # Set postgres superuser password
      sudo -u postgres psql -c "ALTER USER postgres PASSWORD '${postgres_password}';"

      %{ if length(databases) > 0 }
      # Create databases (idempotent)
      %{ for db in databases }
      if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname = '${db}'" | grep -q 1; then
        sudo -u postgres psql -c "CREATE DATABASE \"${db}\""
      fi
      %{ endfor ~}
      %{ endif ~}

      %{ if length(database_users) > 0 }
      # Create users and grant access (idempotent)
      %{ for username, user in database_users }
      if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = '${username}'" | grep -q 1; then
        sudo -u postgres psql -c "CREATE USER \"${username}\" WITH PASSWORD '${user.password}'"
      fi
      %{ for db in databases }
      %{ if user.privileges == "crud" ~}
      # Data access and routine execution only — no DDL. The ALTER DEFAULT
      # PRIVILEGES lines are attached FOR ROLE postgres because migrations run
      # as postgres, so tables and routines it creates later inherit these
      # grants automatically. Without them the app breaks on the next migration.
      sudo -u postgres psql -c "GRANT CONNECT ON DATABASE \"${db}\" TO \"${username}\";"
      sudo -u postgres psql -d "${db}" -c "GRANT USAGE ON SCHEMA public TO \"${username}\";"
      sudo -u postgres psql -d "${db}" -c "GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO \"${username}\";"
      sudo -u postgres psql -d "${db}" -c "GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO \"${username}\";"
      sudo -u postgres psql -d "${db}" -c "GRANT EXECUTE ON ALL ROUTINES IN SCHEMA public TO \"${username}\";"
      sudo -u postgres psql -d "${db}" -c "ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO \"${username}\";"
      sudo -u postgres psql -d "${db}" -c "ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA public GRANT USAGE, SELECT ON SEQUENCES TO \"${username}\";"
      sudo -u postgres psql -d "${db}" -c "ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA public GRANT EXECUTE ON ROUTINES TO \"${username}\";"
      %{ else ~}
      sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE \"${db}\" TO \"${username}\";"
      sudo -u postgres psql -d "${db}" -c "GRANT ALL ON SCHEMA public TO \"${username}\";"
      %{ endif ~}
      %{ endfor ~}
      %{ endfor ~}
      %{ endif ~}

runcmd:
  - curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/postgresql-keyring.gpg
  - echo "deb [signed-by=/usr/share/keyrings/postgresql-keyring.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" | tee /etc/apt/sources.list.d/postgresql.list
  - apt-get update
  - apt-get install -y postgresql-${postgres_version} postgresql-contrib
  - systemctl enable postgresql
  - systemctl start postgresql
  - /opt/nexsware-pg-setup.sh
  - rm -f /opt/nexsware-pg-setup.sh
