#cloud-config
package_update: true
package_upgrade: true
packages:
  - nginx
  - certbot
  - python3-certbot-nginx

write_files:
  - path: /etc/nginx/sites-available/${server_name}
    permissions: '0644'
    content: |
      # HTTP — redirect all traffic to HTTPS
      server {
          listen 80;
          listen [::]:80;
          server_name ${server_name};
          return 301 https://$host$request_uri;
      }

      server {
          listen 443 ssl;
          listen [::]:443 ssl;
          server_name ${server_name};

          ssl_certificate     /etc/letsencrypt/live/${server_name}/fullchain.pem;
          ssl_certificate_key /etc/letsencrypt/live/${server_name}/privkey.pem;
          include             /etc/letsencrypt/options-ssl-nginx.conf;
          ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

          # Security headers
          add_header X-Frame-Options        "SAMEORIGIN"  always;
          add_header X-Content-Type-Options "nosniff"     always;
          add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

          # Proxy upstream blocks
          %{ for proxy in proxy_upstreams ~}
          location ${proxy.path} {
              proxy_pass         ${proxy.backend};
              proxy_http_version 1.1;
              proxy_set_header   Upgrade           $http_upgrade;
              proxy_set_header   Connection        "upgrade";
              proxy_set_header   Host              $host;
              proxy_set_header   X-Real-IP         $remote_addr;
              proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
              proxy_set_header   X-Forwarded-Proto $scheme;
              proxy_cache_bypass $http_upgrade;
              proxy_read_timeout ${proxy_read_timeout}s;
          }
          %{ endfor ~}

          # Static files fallback
          location / {
              root      ${static_root};
              try_files $uri $uri/ /index.html;
              expires   1h;
              add_header Cache-Control "public, no-transform";
          }
      }

runcmd:
%{ if ufw_enabled ~}
  # Before certbot, not after: the HTTP-01 challenge is an inbound request to
  # port 80 from Let's Encrypt's validators, so a host firewall that has not
  # opened 80 yet fails issuance with "Timeout during connect", which reads as
  # a DNS or nginx fault and is neither.
  #
  # 80 stays open afterwards. The renewal cron below re-runs the same challenge
  # every night; closing 80 once the first certificate lands gets you a working
  # site that quietly stops renewing about sixty days later.
  - |
    ufw --force reset
%{ if ssh_allow_from != "" ~}
    ufw allow from ${ssh_allow_from} to any port 22 proto tcp
%{ else ~}
    ufw allow 22/tcp
%{ endif ~}
    ufw allow 80/tcp
    ufw allow 443/tcp
%{ for port in extra_public_ports ~}
    ufw allow ${port}/tcp
%{ endfor ~}
    ufw --force enable
%{ endif ~}
%{ if harden_ssh ~}
  - |
    # Key auth only. The filename has to sort before 50-cloud-init.conf,
    # which ships PasswordAuthentication yes on Ubuntu: sshd takes the FIRST
    # value it obtains for a keyword, so a 99- file would silently lose and
    # leave passwords enabled while looking like it had disabled them.
    cat > /etc/ssh/sshd_config.d/01-nexsware-hardening.conf <<SSHEOF
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PermitRootLogin prohibit-password
    SSHEOF

    # Validate before applying. A config sshd refuses to parse means it will
    # not come back up on restart, which is the same lockout by another route.
    if sshd -t 2>/dev/null; then
      systemctl reload ssh 2>/dev/null || systemctl restart ssh 2>/dev/null || true
    else
      rm -f /etc/ssh/sshd_config.d/01-nexsware-hardening.conf
    fi
%{ endif ~}
  - rm -f /etc/nginx/sites-enabled/default
  - ln -sf /etc/nginx/sites-available/${server_name} /etc/nginx/sites-enabled/${server_name}
  - nginx -t
  - systemctl enable nginx
  - systemctl start nginx
  - certbot --nginx -d ${server_name} --non-interactive --agree-tos -m ${certbot_email} --redirect
  - systemctl reload nginx
  # Certbot auto-renewal
  - echo "0 3 * * * root certbot renew --quiet --post-hook 'systemctl reload nginx'" > /etc/cron.d/certbot-renew
