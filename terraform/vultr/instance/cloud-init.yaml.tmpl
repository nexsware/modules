#cloud-config
package_update: true

write_files:
  - path: /opt/instance-setup.sh
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail

      %{ if private_ip != "" ~}
      # Assign static private IP to the VPC interface
      PRIMARY_IFACE=$(ip route show default | awk '/default/ {print $5; exit}')
      VPC_IFACE=$(ip -o link show | awk -F': ' '{print $2}' | grep -v lo | grep -v "$PRIMARY_IFACE" | head -1)
      SUBNET_PREFIX=$(echo "${instance_subnet}" | cut -d'/' -f2)
      cat > /etc/netplan/99-vpc-static.yaml <<NETEOF
      network:
        version: 2
        ethernets:
          $VPC_IFACE:
            dhcp4: false
            addresses:
              - ${private_ip}/$SUBNET_PREFIX
            %{ if vpc_cidr != "" ~}
            routes:
              - to: ${vpc_cidr}
                on-link: true
            %{ endif ~}
      NETEOF
      chmod 600 /etc/netplan/99-vpc-static.yaml
      netplan apply
      # Remove Vultr's DHCP-assigned IP — netplan apply stops future renewals but
      # doesn't flush the existing lease, so we do it explicitly
      ip -4 addr show dev $VPC_IFACE | grep 'inet ' | awk '{print $2}' | grep -v "^${private_ip}/" | while read -r old_ip; do
        ip addr del "$old_ip" dev $VPC_IFACE 2>/dev/null || true
      done
      %{ endif ~}

      %{ if user_data != "" ~}
      ${user_data}
      %{ endif ~}

runcmd:
  - /opt/instance-setup.sh
  - rm -f /opt/instance-setup.sh
