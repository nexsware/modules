#cloud-config
package_update: true

write_files:
  - path: /opt/instance-setup.sh
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail

      %{ if private_ip != "" }
      # Assign static private IP to the VPC interface
      PRIMARY_IFACE=$(ip route show default | awk '/default/ {print $5; exit}')
      VPC_IFACE=$(ip -o link show | awk -F': ' '{print $2}' | grep -v lo | grep -v "$PRIMARY_IFACE" | head -1)
      SUBNET_PREFIX=$(echo "${instance_subnet}" | cut -d'/' -f2)
      cat > /etc/netplan/99-vpc-static.yaml <<NETEOF
      network:
        version: 2
        ethernets:
          $VPC_IFACE:
            dhcp4: false
            addresses:
              - ${private_ip}/$SUBNET_PREFIX
%{ if db_subnet != "" }
            routes:
              - to: ${db_subnet}
                on-link: true
%{ endif }
      NETEOF
      chmod 600 /etc/netplan/99-vpc-static.yaml
      netplan apply
      # Remove Vultr's DHCP-assigned IP — netplan apply stops future renewals but
      # doesn't flush the existing lease, so we do it explicitly
      ip -4 addr show dev $VPC_IFACE | grep 'inet ' | awk '{print $2}' | grep -v "^${private_ip}/" | while read -r old_ip; do
        ip addr del "$old_ip" dev $VPC_IFACE 2>/dev/null || true
      done
      # Apply routes immediately — netplan apply persists them but may not add them
      # to the live routing table until reboot when the interface is already up
%{ if db_subnet != "" }
      ip route replace ${db_subnet} dev $VPC_IFACE 2>/dev/null || true
%{ endif ~}
      %{ endif ~}

      %{ if ufw_enabled ~}
      # Reset first, so the result is this policy rather than this policy layered
      # over whatever the image happened to ship.
      ufw --force reset

      # SSH before enable, always. Enabling a default-deny firewall without an
      # SSH rule already in place locks the host out, and the only way back in
      # is the provider's web console.
      %{ if ssh_allow_from != "" ~}
      ufw allow from ${ssh_allow_from} to any port 22 proto tcp
      %{ else ~}
      ufw allow 22/tcp
      %{ endif ~}
      %{ for port in public_ports ~}
      ufw allow ${port}/tcp
      %{ endfor ~}
      %{ for rule in internal_rules ~}
      ufw allow from ${rule.cidr} to any port ${rule.port} proto tcp
      %{ endfor ~}
      ufw --force enable
      %{ endif ~}

      # Runs after the firewall is up, so anything installed here that needs a
      # port must open it — either by adding to public_ports/internal_rules
      # above, or with its own ufw call.
      %{ if user_data != "" }
      ${user_data}
      %{ endif ~}

runcmd:
  - /opt/instance-setup.sh
  - rm -f /opt/instance-setup.sh
